# 테스트용 환경변수. 비밀값 아님(로컬 컨테이너 크리덴셜)이라 커밋한다.
# docker-compose.test.yml 의 5433 / 6380 을 가리킨다.
NODE_ENV=test
DATABASE_URL=postgres://ir:ir@localhost:5433/incident_radar
REDIS_URL=redis://localhost:6380
ALERT_WINDOW_MS=60000
SESSION_SECRET=test-session-secret-0123456789
# 명시적으로 비워서 루트 .env 의 WEBHOOK_URL(로컬 데모용 relay 주소)이 ConfigModule 의
# envFilePath fallback(../../.env)으로 새어들어오는 걸 막는다. process.env 에 이미 있으면
# dotenv 가 덮지 않으므로 여기서 빈 값으로 선점.
WEBHOOK_URL=
