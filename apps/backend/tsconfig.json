{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "./dist",
    "baseUrl": "./",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "declaration": false,
    "isolatedModules": false,
    "moduleDetection": "auto",
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": ["src", "test", "jest.config.ts"]
}
