# ---------------------------------------------------------------------------
# 이 파일을 .env 로 복사해서 값을 채운다.  .env 는 git 에 안 올라간다.
# ---------------------------------------------------------------------------

# --- backend ---
NODE_ENV=development
PORT=3000

# Postgres 연결 문자열
DATABASE_URL=postgres://ir:ir@localhost:5432/incident_radar

# Redis 연결 문자열
REDIS_URL=redis://localhost:6379

# 알림 임계값 / 슬라이딩 윈도우 / cooldown
ALERT_THRESHOLD=10
ALERT_WINDOW_MS=60000
ALERT_COOLDOWN_SEC=300

# 알림 webhook (비우면 콘솔 로그로 대체)
WEBHOOK_URL=

# POST /errors 레이트리밋 (IP 기준, 분당). 부하테스트는 이 값을 올려서 한다.
RATE_LIMIT_PER_MIN=600

# CORS 허용 오리진 (프론트 주소)
CORS_ORIGIN=http://localhost:3001

# 대시보드 로그인 세션 쿠키 서명 키 (최소 16자, 아무 랜덤 문자열)
SESSION_SECRET=change-me-to-a-long-random-string

# 관리자 계정 seed 용 (pnpm --filter backend seed:admin 에서만 읽음)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- frontend ---
# 브라우저 번들에 박히는 값 (빌드 타임). 비밀값 금지.
NEXT_PUBLIC_API_URL=http://localhost:3000

# 차트 임계값 선 / cooldown 진행바 분모. 위 ALERT_THRESHOLD / ALERT_COOLDOWN_SEC 와 값을 맞출 것
# (백엔드에서만 바꾸고 여기를 안 바꾸면 화면이 조용히 틀어짐 — 실제 동작엔 영향 없이 표시만 어긋남)
NEXT_PUBLIC_ALERT_THRESHOLD=10
NEXT_PUBLIC_COOLDOWN_SEC=300

# --- tools (트래픽 시뮬레이터) ---
# POST /errors 는 API 키가 필요하다. 발급: pnpm --filter backend seed:api-key sim
SIM_API_KEY=
